# ==========================================
# Soberania AI - Environment Configuration
# ==========================================

# ------------------------------------------
# Environment & Server
# ------------------------------------------
NODE_ENV=development
PORT=3000

# ------------------------------------------
# Database Configuration (PostgreSQL / Neon)
# ------------------------------------------
# URL de conexão com o banco de dados PostgreSQL (Prisma ORM)
DATABASE_URL="postgresql://postgres:local_password_123@localhost:5432/soberania_db?schema=public"

# ------------------------------------------
# Eventos de aula (SSE)
# ------------------------------------------
# poll (padrao): cada conexao consulta o banco a cada 2 s. listen: LISTEN/NOTIFY do Postgres,
# exige conexao direta (sem pooler) e nao vale na Vercel.
CLASS_EVENTS_NOTIFY_MODE="poll"
# Duracao maxima de uma conexao de stream em ms (o navegador reconecta com Last-Event-ID).
# Padrao: 8000 quando VERCEL esta definido, 0 (sem limite) fora dela.
# CLASS_EVENTS_STREAM_MAX_MS=""

# ------------------------------------------
# Authentication & Security
# ------------------------------------------
# Segredo para assinatura de tokens JWT e Sessão de Usuário.
# Em produção (NODE_ENV=production) é obrigatório, com 32+ caracteres: o servidor recusa iniciar sessões sem ele.
# Gere com: openssl rand -base64 48
# Fora de produção, vazio usa um segredo de desenvolvimento.
AUTH_SECRET=""

# Modo demonstração: "true" exibe na tela de login os atalhos com as credenciais do seed.
# Nunca habilite em produção.
NEXT_PUBLIC_DEMO_MODE="false"

# Libera o seed (contas de demonstração com senhas públicas) quando NODE_ENV=production.
# Só para ambientes descartáveis; não use em produção real.
# ALLOW_SEED_IN_PRODUCTION="true"

# Fuso IANA da instituição: horários de aula são digitados e exibidos nele.
# Vazio ou inválido usa America/Sao_Paulo. Lido no build (NEXT_PUBLIC_).
NEXT_PUBLIC_INSTITUTION_TIMEZONE="America/Sao_Paulo"

# SOMENTE PARA TESTES LOCAIS: "true" libera qualquer sessão independente do horário.
# NUNCA ative em produção.
# NEXT_PUBLIC_AGENDA_IGNORE_TIME_WINDOW="false"

# ------------------------------------------
# AI Provider Gateway (SLM / LLM)
# ------------------------------------------
# Provedores suportados: "mock" | "ollama" | "vllm" | "groq" | "together"
AI_PROVIDER=groq

# Base URL para a API de Inferência (compatível com OpenAI /v1/chat/completions)
# Exemplos:
# - Ollama Local: http://localhost:11434/v1
# - vLLM On-Premises: http://localhost:8000/v1
# - Groq Cloud: https://api.groq.com/openai/v1
# - Together Cloud: https://api.together.xyz/v1
AI_BASE_URL="https://api.groq.com/openai/v1"

# Chave de API (Requerida para Groq e Together AI; opcional para Ollama/vLLM)
AI_API_KEY=""

# Modelo de IA utilizado para inferência
# Exemplos por provedor:
# - vLLM / Local: Qwen/Qwen2.5-7B-Instruct-AWQ ou Soberania-SLM-8B-Socratic
# - Ollama: llama3.2:3b
# - Groq: llama-3.2-3b-preview
# - Together: meta-llama/Llama-3.2-3B-Instruct-Turbo
AI_MODEL="openai/gpt-oss-120b"

# Modelo de embeddings (RAG). A dimensao de saida DEVE ser 1024 (coluna vector(1024)); NAO use nomic-embed-text (768).
# O Groq nao oferece embeddings: vazio desliga (busca so lexica). Para ligar, use bge-m3 ou multilingual-e5-large
# e aponte AI_EMBEDDING_BASE_URL para um provedor que tenha o modelo (ex.: Ollama em http://localhost:11434/v1 com bge-m3).
# O provedor "mock" nao precisa disso (hashing local).
AI_EMBEDDING_MODEL=""
# AI_EMBEDDING_BASE_URL="http://localhost:11434/v1"
# AI_EMBEDDING_API_KEY=""

# ------------------------------------------
# Materials, Uploads & Storage Configuration
# ------------------------------------------
MAX_UPLOAD_SIZE_MB="25"
ALLOWED_DOCUMENT_EXTENSIONS="pdf,docx,txt,md"
ENABLE_OCR="true"
# Máximo de páginas renderizadas e reconhecidas por OCR em PDFs escaneados (2 a 5 s por página; acima disso o OCR é parcial)
OCR_MAX_PAGES="30"
STORAGE_PROVIDER="local" # "local" | "r2"
MATERIALS_STORAGE_DIR="./storage/materials"
MEDIA_STORAGE_DIR="./storage/media"

# Cloudflare R2 Configuration (Requerido quando STORAGE_PROVIDER="r2")
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="soberania-materials"
R2_PUBLIC_DOMAIN=""
R2_ENDPOINT="" # ex: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com


# Aceita certificados TLS autoassinados APENAS nas chamadas ao provedor de IA
# (ex.: proxy corporativo/antivirus em desenvolvimento). Nunca habilite em producao.
AI_ALLOW_INSECURE_TLS="false"

# Sandbox Python das ferramentas MCP (mcp_math_python_sandbox).
# ATENCAO: executa codigo Python gerado por LLM no servidor. O limite de tempo/memoria do
# processo NAO substitui isolamento do sistema operacional (container, usuario sem privilegios,
# sem rede). Habilite somente no appliance com isolamento em nivel de SO.
ENABLE_PYTHON_SANDBOX="false"

# Forca o atributo Secure no cookie de sessao mesmo fora de NODE_ENV=production
# (ex.: appliance atras de proxy TLS). Em producao ele ja e sempre Secure.
FORCE_SECURE_COOKIE="false"

# ------------------------------------------
# Testes e2e (opcional)
# ------------------------------------------
# Banco DESCARTAVEL usado por tests/e2e/* (com migracoes e seed aplicados). Sem esta variavel
# os testes e2e sao ignorados (describe.skipIf). Eles criam e removem os proprios dados.
# DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5433/soberania_db?schema=public"
