datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum AgendaType {
  CLASSROOM
  STUDY_GROUP
  EXAM
  DRAFT_REVIEW
  OFFICE_HOURS
}

enum AgendaStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum InteractionType {
  QUESTION
  SOCRATIC_CHALLENGE
  FAQ_CLICK
  DRAFT_SUBMISSION
  EXAM_ANSWER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  role         Role     @default(STUDENT)
  enrollment   String?  @unique
  passwordHash String   @default("")
  avatarUrl    String?
  classId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  class              Class?               @relation(fields: [classId], references: [id])
  sessions           Session[]
  minutes            PedagogicalMinute[]
  interactions       StudentInteraction[]
  submissions        ExamSubmission[]
  teacherSubjects    TeacherSubject[]
  teacherAgendas     Agenda[]             @relation("TeacherAgendas")
  studyGroupMessages StudyGroupMessage[]
  draftSubmissions   DraftSubmission[]

  @@index([classId])
  @@map("users")
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  sessionToken String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@map("sessions")
}

enum AcademicLevel {
  HIGHER_EDUCATION
  HIGH_SCHOOL
  ELEMENTARY
}

// Curso (ex.: "Análise e Desenvolvimento de Sistemas", "Ensino Médio")
model Course {
  id            String        @id @default(cuid())
  name          String
  code          String        @unique // ex: "ADS"
  academicLevel AcademicLevel @default(HIGHER_EDUCATION)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  disciplines Discipline[]
  classes     Class[]

  @@map("courses")
}

// Disciplina da matriz curricular do curso (catálogo)
model Discipline {
  id            String   @id @default(cuid())
  courseId      String
  code          String // ex: "BD101", único dentro do curso
  name          String // ex: "Banco de Dados I"
  description   String?  @db.Text
  workloadHours Int // carga horária da matriz, ex: 80
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course    Course    @relation(fields: [courseId], references: [id])
  offerings Subject[]

  @@unique([courseId, code])
  @@index([courseId])
  @@map("disciplines")
}

model Class {
  id               String   @id @default(cuid())
  courseId         String
  academicPeriodId String
  name             String
  code             String   @unique
  semester         Int // posição na matriz: 3 = 3º semestre (superior) ou 3º ano (médio/fundamental)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  course         Course         @relation(fields: [courseId], references: [id])
  academicPeriod AcademicPeriod @relation(fields: [academicPeriodId], references: [id])
  students       User[]
  agendas        Agenda[]
  subjects       Subject[]

  @@index([courseId])
  @@index([academicPeriodId])
  @@map("classes")
}

model Agenda {
  id           String       @id @default(cuid())
  title        String
  subject      String
  type         AgendaType
  status       AgendaStatus @default(SCHEDULED)
  startTime    DateTime
  endTime      DateTime
  videoUrl     String?
  classId      String
  teacherId    String?
  subjectId    String?
  lessonPlanId String?      @unique
  assessmentId String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  class              Class                @relation(fields: [classId], references: [id])
  teacher            User?                @relation("TeacherAgendas", fields: [teacherId], references: [id])
  subjectRef         Subject?             @relation(fields: [subjectId], references: [id])
  assessment         Assessment?          @relation(fields: [assessmentId], references: [id])
  minutes            PedagogicalMinute[]
  interactions       StudentInteraction[]
  submissions        ExamSubmission[]
  lessonPlan         LessonPlan?          @relation(fields: [lessonPlanId], references: [id])
  studyGroupMessages StudyGroupMessage[]
  draftSubmissions   DraftSubmission[]

  @@index([classId])
  @@index([teacherId])
  @@index([subjectId])
  @@index([assessmentId])
  @@map("agendas")
}

// ==========================================
// Módulo de Gestão Acadêmica & Professores (Etapa 0)
// ==========================================

model Subject {
  id           String   @id @default(cuid())
  disciplineId String
  classId      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  discipline         Discipline       @relation(fields: [disciplineId], references: [id])
  class              Class            @relation(fields: [classId], references: [id])
  teacherAssignments TeacherSubject[]
  teachingPlans      TeachingPlan[]
  agendas            Agenda[]

  @@unique([disciplineId, classId])
  @@index([classId])
  @@index([disciplineId])
  @@map("subjects")
}

// Tabela Pivô para Vínculo N:N (Professor <-> Matérias)
model TeacherSubject {
  id        String   @id @default(cuid())
  teacherId String
  subjectId String
  createdAt DateTime @default(now())

  teacher User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
  @@index([teacherId])
  @@index([subjectId])
  @@map("teacher_subjects")
}

// ==========================================
// Esteira Pedagógica do Professor (Etapas 1 a 4)
// ==========================================

// Modelo de Período Letivo Normalizado (Base)
model AcademicPeriod {
  id        String    @id @default(cuid())
  name      String // ex: "1º Semestre / 2026 (2026.1)"
  code      String    @unique // ex: "2026.1"
  year      Int       @default(2026)
  semester  Int? // 1, 2, ou null para anual
  type      String    @default("SEMESTER") // "SEMESTER" | "ANNUAL" | "TERM" | "INTENSIVE"
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  classes Class[]

  @@map("academic_periods")
}

enum ChapterSource {
  OUTLINE
  AI
  MANUAL
  HEADINGS
}

enum ReferenceKind {
  BASIC
  COMPLEMENTARY
}

enum LessonStatus {
  DRAFT
  PUBLISHED
}

// 1. Plano de Ensino (Macro)
model TeachingPlan {
  id                  String   @id @default(cuid())
  subjectId           String
  teacherId           String
  syllabus            String   @db.Text
  generalObjectives   String   @db.Text
  specificObjectives  String   @db.Text
  unitsContent        Json
  methodology         String   @db.Text
  assessmentCriteria  String   @db.Text
  basicBibliography   String[]
  complementaryBiblio String[]
  status              String   @default("DRAFT")
  totalHours          Int
  theoryHours         Int
  practiceHours       Int
  ndeComplianceStatus String   @default("Pendente de Avaliação Colegiado")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  subject     Subject                 @relation(fields: [subjectId], references: [id])
  schedules   CourseSchedule[]
  assessments Assessment[]
  references  TeachingPlanReference[]

  @@index([subjectId])
  @@map("teaching_plans")
}

model TeachingPlanReference {
  id             String        @id @default(cuid())
  teachingPlanId String
  materialId     String
  kind           ReferenceKind

  teachingPlan TeachingPlan     @relation(fields: [teachingPlanId], references: [id], onDelete: Cascade)
  material     DidacticMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([teachingPlanId, materialId])
  @@map("teaching_plan_references")
}

// 2. Cronograma de Aulas (Calendário)
model CourseSchedule {
  id             String   @id @default(cuid())
  teachingPlanId String
  startDate      DateTime
  endDate        DateTime
  holidays       Json? // Datas de recessos e feriados
  totalClasses   Int
  startTime      String   @default("19:00") @map("start_time") // HH:mm no fuso da instituição
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  teachingPlan TeachingPlan @relation(fields: [teachingPlanId], references: [id], onDelete: Cascade)
  lessonPlans  LessonPlan[]

  @@map("course_schedules")
}

// 3. Plano de Aula (Micro / Encontro Específico)
model LessonPlan {
  id               String       @id @default(cuid())
  courseScheduleId String
  classDate        DateTime
  classNumber      Int
  topicTitle       String
  dailyObjective   String       @db.Text
  timeScript       Json // Roteiro minuto a minuto [{ timeRange, activity, description }]
  methodology      String       @db.Text
  resourcesNeeded  String[]
  fixationExercise String       @db.Text
  mediaType        String? // "YOUTUBE" | "S3_UPLOAD" | "NONE"
  mediaUrl         String? // URL do YouTube ou URI do S3
  s3ObjectKey      String? // Chave do objeto no S3 da instituição
  status           LessonStatus @default(DRAFT)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  courseSchedule CourseSchedule      @relation(fields: [courseScheduleId], references: [id], onDelete: Cascade)
  agenda         Agenda?
  chapters       LessonPlanChapter[]

  @@index([courseScheduleId])
  @@map("lesson_plans")
}

model LessonPlanChapter {
  lessonPlanId String
  chapterId    String

  lessonPlan LessonPlan      @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  chapter    MaterialChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@id([lessonPlanId, chapterId])
  @@map("lesson_plan_chapters")
}

// 4. Instrumentos de Avaliação
model Assessment {
  id              String   @id @default(cuid())
  teachingPlanId  String
  title           String
  type            String // "EXAM" | "GROUP_WORK" | "CASE_STUDY"
  questions       Json // Questões, enunciados, gabaritos e critérios
  rubrics         Json // Rubricas formais de correção
  maxScore        Float    @default(10.0)
  durationMinutes Int      @default(60)
  status          String   @default("DRAFT")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  teachingPlan TeachingPlan        @relation(fields: [teachingPlanId], references: [id], onDelete: Cascade)
  agendas      Agenda[]
  chapters     AssessmentChapter[]

  @@map("assessments")
}

model AssessmentChapter {
  assessmentId String
  chapterId    String

  assessment Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  chapter    MaterialChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@id([assessmentId, chapterId])
  @@map("assessment_chapters")
}

// Tabela Base para Categorias do Acervo Bibliográfico & Documentos
model DocumentCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  color       String?  @default("teal")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  materials DidacticMaterial[]

  @@map("document_categories")
}

model DidacticMaterial {
  id               String   @id @default(cuid())
  title            String
  author           String
  edition          String?
  subject          String
  totalPages       Int
  filePath         String
  originalFilename String?
  fileSize         Int?
  mimeType         String?
  isOcrApplied     Boolean  @default(false)
  status           String   @default("INDEXED") // UPLOADING, PARSING, OCR_PROCESSING, INDEXED, INDEXED_LEXICAL_ONLY (sem embeddings, só busca lexical), ERROR
  errorMessage     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  chunks         MaterialChunk[]
  categories     DocumentCategory[]
  chapters       MaterialChapter[]
  planReferences TeachingPlanReference[]

  @@map("didactic_materials")
}

model MaterialChapter {
  id         String        @id @default(cuid())
  materialId String
  title      String
  order      Int
  startPage  Int
  endPage    Int?
  source     ChapterSource
  parentId   String?
  depth      Int           @default(0)
  createdAt  DateTime      @default(now())

  material        DidacticMaterial    @relation(fields: [materialId], references: [id], onDelete: Cascade)
  parent          MaterialChapter?    @relation("ChapterTree", fields: [parentId], references: [id], onDelete: Cascade)
  children        MaterialChapter[]   @relation("ChapterTree")
  chunks          MaterialChunk[]
  lessonLinks     LessonPlanChapter[]
  assessmentLinks AssessmentChapter[]

  @@unique([materialId, order])
  @@index([parentId])
  @@map("material_chapters")
}

model MaterialChunk {
  id         String   @id @default(cuid())
  materialId String
  chapter    String
  chapterId  String?
  section    String?
  pageNumber Int
  content    String   @db.Text
  createdAt  DateTime @default(now())

  // Colunas gerenciadas via SQL (migration pgvector_fulltext): embedding vetorial e tsvector gerado
  embedding  Unsupported("vector(1024)")?
  contentTsv Unsupported("tsvector")?     @map("content_tsv")

  material   DidacticMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  chapterRef MaterialChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  @@index([materialId])
  @@index([chapterId])
  @@index([pageNumber])
  @@map("material_chunks")
}

model PedagogicalMinute {
  id                         String   @id @default(cuid())
  agendaId                   String
  studentId                  String
  engagementScore            Float // 0 to 100
  hesitationIndex            Float // 0 to 100
  topicsMastered             String[]
  topicsStruggled            String[]
  rawSummary                 String   @db.Text
  actionableAdvice           String   @db.Text
  totalQuestionsAsked        Int      @default(0)
  socraticChallengesAnswered Int      @default(0)
  sessionTitle               String   @default("")
  aiFallback                 Boolean  @default(false) // true = métricas reais, parecer textual não redigido pela IA
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  agenda  Agenda @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([agendaId, studentId])
  @@index([agendaId])
  @@index([studentId])
  @@map("pedagogical_minutes")
}

model StudentInteraction {
  id                  String          @id @default(cuid())
  agendaId            String
  studentId           String
  type                InteractionType
  timestampInVideo    Int? // seconds
  questionText        String          @db.Text
  responseText        String          @db.Text
  ragSourcePage       Int?
  ragSourceBook       String?
  isSocraticChallenge Boolean         @default(false)
  wasCorrect          Boolean?
  agendaType          AgendaType      @default(CLASSROOM)
  guardrailBlocked    Boolean         @default(false)
  latencyMs           Int?
  createdAt           DateTime        @default(now())

  agenda  Agenda @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([agendaId])
  @@index([studentId])
  @@map("student_interactions")
}

model ExamSubmission {
  id           String   @id @default(cuid())
  agendaId     String
  studentId    String
  score        Float
  maxScore     Float    @default(10.0)
  answers      Json // Array of [questionId, chosenOption, timeSpentSeconds, hesitationSeconds]
  integrityLog Json? // Tab blur events, suspicious prompts
  submittedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  agenda  Agenda @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([agendaId, studentId])
  @@map("exam_submissions")
}

model StudyGroupMessage {
  id        String   @id @default(cuid())
  agendaId  String
  authorId  String?
  content   String   @db.Text
  isAi      Boolean  @default(false)
  createdAt DateTime @default(now())

  agenda Agenda @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorId], references: [id])

  @@index([agendaId])
  @@map("study_group_messages")
}

model DraftSubmission {
  id           String   @id @default(cuid())
  agendaId     String
  studentId    String
  content      String   @db.Text
  feedback     String?  @db.Text
  rubricScores Json?
  aiFallback   Boolean  @default(false) // true = IA indisponível; feedback e notas nulos
  createdAt    DateTime @default(now())

  agenda  Agenda @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([agendaId])
  @@index([studentId])
  @@map("draft_submissions")
}

model InferenceLog {
  id                   String      @id @default(cuid())
  provider             String
  model                String
  ttftMs               Int
  totalLatencyMs       Int
  tokensPerSecond      Float
  promptTokens         Int
  completionTokens     Int
  externalTrafficBytes Int         @default(0)
  fallback             Boolean     @default(false)
  agendaType           AgendaType?
  createdAt            DateTime    @default(now())

  @@index([createdAt])
  @@map("inference_logs")
}
